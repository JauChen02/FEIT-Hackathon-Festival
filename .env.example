# ---------------------------------------------------------------------------
# LearnArena environment. Copy to .env.local and fill in.
# Secrets MUST NOT use the NEXT_PUBLIC_ prefix (PLANNING.md §19.1).
# ---------------------------------------------------------------------------

# One of: local | test | preview | production  (PLANNING.md §21.3)
# Destructive commands (db:reset, drizzle-kit push) refuse to run outside local/test.
APP_ENV=local

# ---------------------------------------------------------------------------
# Database (server-only). With `pnpm supabase start` this is the local stack.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Supabase Auth. URL + anon key are public by design; the service-role key is
# server/test-only and grants full access.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the web app; used for the CSRF Origin check (§19.1)
# and for auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability. Sentry is inert when SENTRY_DSN is unset.
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# Multiplayer: same signing secret on web and realtime. Use a random 32-byte value.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_TOKEN_SECRET=
# PORT is used by the realtime service when launched separately (default 3001).

# Redis HTTP API. setup:local provides a local bridge; use Upstash when hosted.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=learnarena-local-only
# Only set this to a header overwritten by your trusted reverse proxy.
TRUSTED_CLIENT_IP_HEADER=

# Optional AI prose; deterministic Coach and template messages work without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional browser push. setup:local generates a local VAPID key pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Root dev/start runs the built-in worker. For separately hosted processes,
# set BACKGROUND_JOB_MODE=worker on both web and realtime and run the worker.
BACKGROUND_JOB_MODE=worker
# Alternatively use Inngest instead of the worker, set BACKGROUND_JOB_MODE=inngest,
# configure /api/inngest and supply these credentials.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
